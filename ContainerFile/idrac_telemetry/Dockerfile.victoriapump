# Dockerfile for VictoriaPump - iDRAC Telemetry Data Pump for VictoriaMetrics
# Builds from iDRAC-Telemetry-Reference-Tools source

ARG IDRAC_TELEMETRY_VERSION=main
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=telemetry
ARG GROUPNAME=telemetry

FROM golang:1.24 AS builder

ARG USER_ID
ARG GROUP_ID
ARG USERNAME
ARG GROUPNAME
ARG IDRAC_TELEMETRY_VERSION

WORKDIR /build

# System updates
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN (getent group ${GROUP_ID} && groupdel $(getent group ${GROUP_ID} | cut -d: -f1)) || : && \
    (getent group ${GROUPNAME} && groupdel ${GROUPNAME}) || : && \
    (getent passwd ${USERNAME} && userdel -f ${USERNAME}) || : && \
    groupadd -g ${GROUP_ID} ${GROUPNAME} && \
    useradd -l -u ${USER_ID} -g ${GROUPNAME} ${USERNAME}

# Clone iDRAC Telemetry Reference Tools repository
RUN git clone --depth 1 --branch ${IDRAC_TELEMETRY_VERSION} \
    https://github.com/dell/iDRAC-Telemetry-Reference-Tools.git /build/source

WORKDIR /build/source

# Build VictoriaPump
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -o /build/victoriapump \
    ./cmd/victoriapump

# Final minimal image
FROM scratch

ARG USERNAME=telemetry

# Copy CA certificates for HTTPS
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy user/group files
COPY --from=builder /etc/passwd /etc/group /etc/

# Copy binary
COPY --from=builder /build/victoriapump /victoriapump

# Metadata labels
LABEL org.opencontainers.image.title="VictoriaPump" \
      org.opencontainers.image.description="iDRAC Telemetry Data Pump for VictoriaMetrics" \
      org.opencontainers.image.vendor="Dell Technologies" \
      org.opencontainers.image.source="https://github.com/dell/iDRAC-Telemetry-Reference-Tools"

USER ${USERNAME}
EXPOSE 2112
ENTRYPOINT ["/victoriapump"]
