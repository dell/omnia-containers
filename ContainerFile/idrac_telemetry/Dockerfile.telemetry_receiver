# Dockerfile for Telemetry Receiver - Complete iDRAC Telemetry Collection Service
# Builds from iDRAC-Telemetry-Reference-Tools source
# Includes: idrac-telemetry-receiver, dbdiscauth, configui, redfishread

ARG IDRAC_TELEMETRY_VERSION=main
ARG USER_ID=1000
ARG GROUP_ID=1000
ARG USERNAME=telemetry
ARG GROUPNAME=telemetry

FROM golang:1.24 AS builder

ARG USER_ID
ARG GROUP_ID
ARG USERNAME
ARG GROUPNAME
ARG IDRAC_TELEMETRY_VERSION

WORKDIR /build

# System updates
RUN DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get -y dist-upgrade && \
    rm -rf /var/lib/apt/lists/*

# Clone iDRAC Telemetry Reference Tools repository
RUN git clone --depth 1 --branch ${IDRAC_TELEMETRY_VERSION} \
    https://github.com/dell/iDRAC-Telemetry-Reference-Tools.git /build/source

WORKDIR /build/source

# Download dependencies first for better caching
RUN go mod download

# Build all binaries with version information
RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -o /build/idrac-telemetry-receiver \
    ./cmd/idrac-telemetry-receiver

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -o /build/dbdiscauth \
    ./cmd/dbdiscauth

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -o /build/configui \
    ./cmd/configui

RUN CGO_ENABLED=0 GOOS=linux go build \
    -ldflags="-w -s" \
    -o /build/redfishread \
    ./cmd/redfishread

# Create non-root user
RUN (getent group ${GROUP_ID} && groupdel $(getent group ${GROUP_ID} | cut -d: -f1)) || : && \
    (getent group ${GROUPNAME} && groupdel ${GROUPNAME}) || : && \
    (getent passwd ${USERNAME} && userdel -f ${USERNAME}) || : && \
    groupadd -g ${GROUP_ID} ${GROUPNAME} && \
    useradd -l -u ${USER_ID} -g ${GROUPNAME} ${USERNAME}

# Final minimal image
FROM scratch

ARG USERNAME=telemetry

# Copy CA certificates for HTTPS
COPY --from=builder /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/

# Copy user/group files
COPY --from=builder /etc/passwd /etc/group /etc/

# Copy all binaries
COPY --from=builder /build/idrac-telemetry-receiver /idrac-telemetry-receiver
COPY --from=builder /build/dbdiscauth /dbdiscauth
COPY --from=builder /build/configui /configui
COPY --from=builder /build/redfishread /redfishread

# Metadata labels
LABEL org.opencontainers.image.title="iDRAC Telemetry Receiver" \
      org.opencontainers.image.description="Complete iDRAC Telemetry Collection Service" \
      org.opencontainers.image.vendor="Dell Technologies" \
      org.opencontainers.image.source="https://github.com/dell/iDRAC-Telemetry-Reference-Tools"

USER ${USERNAME}
ENTRYPOINT ["/idrac-telemetry-receiver"]
