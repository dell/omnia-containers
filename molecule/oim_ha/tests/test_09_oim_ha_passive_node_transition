            print(f"\nSSH to compute node {node}: {result.stdout.strip()}")

    if failed_nodes:
        pytest.fail(f"\nPasswordless SSH check failed for compute nodes: {failed_nodes}")
    else:
        print("\nPasswordless SSH to all compute nodes successful!")

