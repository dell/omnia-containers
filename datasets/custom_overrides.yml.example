# Custom TC Override Example
# Copy this file to custom_overrides.yml and define your custom test cases.
# Custom TCs are merged with built-in TCs during generation.
#
# Usage:
#   cp datasets/custom_overrides.yml.example datasets/custom_overrides.yml
#   # Edit custom_overrides.yml with your TC definitions
#   python utility/generate_datasets.py --clean my_custom_tc
#
# Structure:
#   custom_test_cases:
#     <tc_name>:
#       metadata:         # TC description and coverage info (for manifest)
#       overrides:        # Template variable overrides (same keys as TC_OVERRIDES)
#       software_config:  # Full software_config.json content (optional)

custom_test_cases:

  # Example: Custom GPU cluster with VAST storage and DCGM telemetry
  tc_custom_gpu:
    metadata:
      description: "Custom GPU Cluster — Slurm+K8s, DCGM+VAST, air-gap"
      coverage:
        software_stack: "Slurm+K8s"
        telemetry_sources: "iDRAC+LDMS+DCGM+VAST"
        storage_backend: "VAST-NFS"
        s3_provider: "MinIO"
        network_topology: "Single-subnet"
        dns_mode: "On"
        architecture: "x86_64"
        repo_strategy: "always"
        options:
          - "DCGM"
          - "VAST"
      playbook_order:
        - omnia.sh
        - prepare_oim
        - local_repo
        - build_image_x86_64
        - provision
        - telemetry

    overrides:
      admin_network:
        oim_nic_name: "eno1"
        subnet: "10.70.0.0"
        netmask_bits: "24"
        primary_oim_admin_ip: "10.70.0.1"
        primary_oim_bmc_ip: ""
        router: "10.70.0.1"
        dynamic_range: "10.70.0.100-10.70.0.200"
        dns:
          - "10.70.0.1"
        ntp_servers:
          - address: "10.70.0.1"
            type: "server"
        additional_subnets: []
      ib_network:
        subnet: "192.168.6.0"
        netmask_bits: "24"
        dns: []
      # Enable DCGM and VAST telemetry
      telemetry_dcgm_support: true
      telemetry_vast_metrics_enabled: true
      telemetry_vast_endpoint: "https://10.70.0.50:443"
      # PXE nodes
      pxe_mapping_rows:
        - FUNCTIONAL_GROUP_NAME: "service_kube_control_plane_first_x86_64"
          GROUP_NAME: "mgmt"
          SERVICE_TAG: "CUST01"
          PARENT_SERVICE_TAG: ""
          HOSTNAME: "k8s-cp01"
          ADMIN_MAC: "AA:BB:CC:01:07:01"
          ADMIN_IP: "10.70.0.11"
          BMC_MAC: "AA:BB:CC:02:07:01"
          BMC_IP: "10.70.0.211"
          IB_NIC_NAME: ""
          IB_IP: ""
        - FUNCTIONAL_GROUP_NAME: "slurm_node_x86_64"
          GROUP_NAME: "grp1"
          SERVICE_TAG: "CUST02"
          PARENT_SERVICE_TAG: ""
          HOSTNAME: "gpu-n01"
          ADMIN_MAC: "AA:BB:CC:01:07:02"
          ADMIN_IP: "10.70.0.12"
          BMC_MAC: "AA:BB:CC:02:07:02"
          BMC_IP: "10.70.0.212"
          IB_NIC_NAME: "ib0"
          IB_IP: "192.168.6.12"

    software_config:
      cluster_os_type: "rhel"
      cluster_os_version: "10.0"
      repo_config: "always"
      softwares:
        - name: "default_packages"
          arch: ["x86_64"]
        - name: "admin_debug_packages"
          arch: ["x86_64"]
        - name: "slurm_custom"
          arch: ["x86_64"]
        - name: "service_k8s"
          version: "1.35.1"
          arch: ["x86_64"]
        - name: "ldms"
          arch: ["x86_64"]
        - name: "additional_packages"
          arch: ["x86_64"]
      slurm_custom:
        - name: "slurm_control_node"
        - name: "slurm_node"
        - name: "login_node"
      service_k8s:
        - name: "service_kube_control_plane_first"
        - name: "service_kube_control_plane"
        - name: "service_kube_node"
      additional_packages:
        - name: "slurm_node"
        - name: "service_kube_node"
